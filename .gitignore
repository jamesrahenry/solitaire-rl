.venv/
__pycache__/
*.pyc
.pytest_cache/
*.Identifier

# per-step model checkpoints are large, regenerable (from the run's logged
# seed+action games.jsonl, or by re-running training) and not useful to
# version - keep the lightweight logs/metrics/configs/plots for study instead
runs/*/checkpoint_*.pt
runs/bc_pretrained*.pt

# scratch dataset cache for agent/behavior_cloning.py, regenerated from
# runs/curriculum_wins.jsonl on demand
runs/_bc_cache/
runs/_smoketest/

# derived BC training subsets (a deterministic sample of runs/curriculum_wins.jsonl,
# regenerable from it) - keep the small source corpus, not its large derived slices
runs/bc_training_subset.jsonl

# the heuristic-harvest corpus itself (225MB+) - regenerable via agent/harvest_wins.py,
# and too large for a normal git push (GitHub hard-blocks single files over 100MB)
runs/curriculum_wins.jsonl
